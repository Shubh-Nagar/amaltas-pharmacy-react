# Optional: POST endpoint for the chat assistant. Receives {"message": "..."} and must return {"reply": "..."}.
# If empty, the built-in keyword answers are used.
VITE_CHAT_ENDPOINT=

# Optional: where the home-page enquiry form is POSTed (JSON). If empty, it is emailed to
# amaltaspharmacy@gmail.com through formsubmit.co (activate it once from the first email it sends).
VITE_ENQUIRY_ENDPOINT=
